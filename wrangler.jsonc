{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "cataqui-api",
	"main": "src/platform/cloudflare/index.ts",
	"compatibility_date": "2025-12-18",
	"compatibility_flags": ["nodejs_compat"],
	"containers": [
		{
			"class_name": "ApiContainer",
			"image": "./Dockerfile",
			"max_instances": 10,
			"instance_type": "basic",
		},
	],

	"durable_objects": {
		"bindings": [
			{
				"name": "API_CONTAINER",
				"class_name": "ApiContainer",
			},
		],
	},
	"queues": {
		"producers": [
			{
				"binding": "DERIVE_JOB_DATA_QUEUE",
				"queue": "cataqui-api-derive-job-data",
			},
		],
		"consumers": [
			{
				"queue": "cataqui-api-derive-job-data",
				"max_batch_size": 1,
				"max_batch_timeout": 1,
				"max_concurrency": 3,
				"max_retries": 3,
				"retry_delay": 60,
				"dead_letter_queue": "cataqui-api-derive-job-data-dlq",
			},
		],
	},

	"migrations": [
		{
			"tag": "v1",
			"new_sqlite_classes": ["ApiContainer"],
		},
	],

	"vars": {
		"NODE_ENV": "production",
	},

	"observability": {
		"enabled": true,
		"head_sampling_rate": 0.1,
	},

	"env": {
		"staging": {
			"name": "cataqui-api-staging",
			"containers": [
				{
					"class_name": "ApiContainer",
					"image": "./Dockerfile",
					"max_instances": 3,
					"instance_type": "basic",
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "API_CONTAINER",
						"class_name": "ApiContainer",
					},
				],
			},
			"queues": {
				"producers": [
					{
						"binding": "DERIVE_JOB_DATA_QUEUE",
						"queue": "cataqui-api-derive-job-data-staging",
					},
				],
				"consumers": [
					{
						"queue": "cataqui-api-derive-job-data-staging",
						"max_batch_size": 1,
						"max_batch_timeout": 1,
						"max_concurrency": 1,
						"max_retries": 3,
						"retry_delay": 60,
						"dead_letter_queue": "cataqui-api-derive-job-data-staging-dlq",
					},
				],
			},
			"routes": [{ "pattern": "staging.api.cataqui.com", "custom_domain": true }],
			"vars": {
				"NODE_ENV": "staging",
				"SLEEP_AFTER": "5m",
				"CORS_ORIGINS": "https://staging.cataqui.com",
				"PROTOMAP_URL": "https://staging.maptiles.cataqui.com",
				"CLOUDFLARE_ACCOUNT_ID": "1fca946385505503c59dd6a2a4eeb442",
				"CLOUDFLARE_AI_GATEWAY_ID": "staging",
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 1.0,
			},
		},
		"production": {
			"name": "cataqui-api-production",
			"containers": [
				{
					"class_name": "ApiContainer",
					"image": "./Dockerfile",
					"max_instances": 10,
					"instance_type": "standard-1",
				},
			],
			"durable_objects": {
				"bindings": [
					{
						"name": "API_CONTAINER",
						"class_name": "ApiContainer",
					},
				],
			},
			"queues": {
				"producers": [
					{
						"binding": "DERIVE_JOB_DATA_QUEUE",
						"queue": "cataqui-api-derive-job-data-production",
					},
				],
				"consumers": [
					{
						"queue": "cataqui-api-derive-job-data-production",
						"max_batch_size": 1,
						"max_batch_timeout": 1,
						"max_concurrency": 3,
						"max_retries": 3,
						"retry_delay": 60,
						"dead_letter_queue": "cataqui-api-derive-job-data-production-dlq",
					},
				],
			},
			"routes": [{ "pattern": "api.cataqui.com", "custom_domain": true }],
			"vars": {
				"NODE_ENV": "production",
				"SLEEP_AFTER": "1h",
				"CORS_ORIGINS": "https://cataqui.com",
				"PROTOMAP_URL": "https://maptiles.cataqui.com",
				"CLOUDFLARE_ACCOUNT_ID": "1fca946385505503c59dd6a2a4eeb442",
				"CLOUDFLARE_AI_GATEWAY_ID": "production",
			},
			"observability": {
				"enabled": true,
				"head_sampling_rate": 0.05,
			},
		},
	},
}
