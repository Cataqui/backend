# Build outputs (rebuilt inside Docker)
**/dist/
**/generated/
!apps/mapshot/generated/
apps/mapshot/generated/*
!apps/mapshot/generated/source-indexes/
!apps/mapshot/generated/source-indexes/**
**/coverage/
apps/mapshot/renderer/target/
**/.wrangler/
**/.cloudflare/
**/.worker-build/

# Dependencies (rebuilt inside Docker)
**/node_modules/
vendor/bundle/
.bundle/
apps/mapshot/.venv/

# Environment & secrets
**/.env
**/.dev.vars
**/.dev.vars.*
**/.env.*
!**/.env.example
**/.infisical-secrets

# Git
.git/
.gitignore

# Dev tooling
.husky/
.vscode/
.opencode/
.agents/
skills-lock.json

# Testing
.vitest-attachments/
**/.vitest-attachments/
test/
vitest.config.ts
**/*.spec.ts
**/*.e2e-spec.ts

# Docker files (don't copy into image)
Dockerfile
docker-compose.yml
.dockerignore

# CI & meta
.github/
infrastructure/
commitlint.config.mjs
.editorconfig
.prettierrc
eslint.config.mjs

# Mapshot's check stages execute its source tests inside Docker.
!apps/mapshot/test/
!apps/mapshot/test/**
!apps/mapshot/**/*.spec.ts
!apps/mapshot/vitest.config.ts
