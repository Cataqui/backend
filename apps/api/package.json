{
	"name": "@cataqui/api",
	"version": "1.0.0",
	"description": "Cataquí private user API and its Cloudflare container gateway",
	"author": "Cataquí Team",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"files": [
		"dist",
		"generated",
		"package.json"
	],
	"scripts": {
		"build": "pnpm build:nest && pnpm build:worker",
		"build:nest": "nest build && tsc-alias -f",
		"build:worker": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist/worker --containers-rollout none",
		"cf:containers:list": "wrangler containers list",
		"cf:deploy:production": "wrangler deploy --config wrangler.jsonc --env production",
		"cf:deploy:staging": "wrangler deploy --config wrangler.jsonc --env staging",
		"cf:dev": "wrangler dev --config wrangler.jsonc --env-file \"$PWD/../../.env\"",
		"cf:secret:put": "wrangler secret put --config wrangler.jsonc",
		"cf:tail": "wrangler tail --config wrangler.jsonc",
		"cf:types": "wrangler types api-worker-env.d.ts --config wrangler.jsonc --env-interface ApiWorkerEnv --include-runtime false --env-file \"$PWD/../../.env.example\" && node scripts/generate-api-worker-environment.mjs",
		"cf:types:check": "wrangler types api-worker-env.d.ts --check --config wrangler.jsonc --env-interface ApiWorkerEnv --include-runtime false --env-file \"$PWD/../../.env.example\" && node scripts/generate-api-worker-environment.mjs --check",
		"clean": "node -e \"for (const target of ['coverage','dist','generated']) require('node:fs').rmSync(target,{recursive:true,force:true})\"",
		"prebuild": "pnpm prisma:generate",
		"pretest": "pnpm prisma:generate",
		"pretest:cov": "pnpm prisma:generate",
		"pretypecheck": "pnpm prisma:generate",
		"prisma:generate": "prisma generate",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:studio": "prisma studio",
		"prisma:validate": "prisma validate",
		"start": "nest start --exec tsx",
		"start:debug": "nest start --debug --watch --exec tsx",
		"start:dev": "nest start --watch --exec tsx",
		"start:prod": "node dist/src/main.js",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --noEmit -p src/platform/cloudflare/tsconfig.json && pnpm cf:types:check"
	},
	"dependencies": {
		"@cataqui/api-internal-ingress": "workspace:*",
		"@cataqui/microservices-auth-schemas": "workspace:*",
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/static": "^10.1.3",
		"@nestjs/common": "12.1.2",
		"@nestjs/config": "12.0.1",
		"@nestjs/core": "12.1.2",
		"@nestjs/platform-fastify": "12.1.2",
		"@nestjs/swagger": "12.0.2",
		"@nestjs/terminus": "^12.1.0",
		"@nestjs/throttler": "^6.7.1",
		"@prisma/adapter-neon": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@upstash/redis": "^1.38.2",
		"ai": "^6.0.244",
		"ai-gateway-provider": "^3.2.0",
		"jose": "catalog:",
		"libphonenumber-js": "^1.13.10",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "catalog:",
		"zod-openapi": "^6.0.0"
	},
	"devDependencies": {
		"@cloudflare/containers": "^0.3.7",
		"@cloudflare/workers-types": "catalog:",
		"@nestjs/cli": "12.0.8",
		"@nestjs/schematics": "12.0.6",
		"@nestjs/testing": "12.1.2",
		"@standard-schema/spec": "1.1.0",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "catalog:",
		"dotenv": "^17.4.2",
		"fast-check": "catalog:",
		"fastify": "5.12.5",
		"prisma": "^7.9.1",
		"tsc-alias": "^1.8.17",
		"tsx": "^4.23.9",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
