		"@nestjs/schematics": "12.0.6",
		"@nestjs/testing": "12.1.2",
		"@standard-schema/spec": "1.1.0",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"dotenv": "catalog:",
		"fast-check": "catalog:",
		"fastify": "5.12.5",
		"prisma": "catalog:",
		"tsx": "^4.23.9",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"tsdown": "catalog:",
		"testdouble": "catalog:"
	}
