		"@nestjs/config": "12.0.1",
		"@nestjs/core": "12.1.2",
		"@nestjs/platform-fastify": "12.1.2",
		"@nestjs/swagger": "12.0.2",
		"@nestjs/terminus": "^12.1.0",
		"@nestjs/throttler": "^6.7.1",
		"@prisma/adapter-neon": "^7.10.1",
		"@prisma/client": "catalog:",
		"@upstash/redis": "catalog:",
		"ai": "^6.0.304",
		"ai-gateway-provider": "^3.2.0",
		"libphonenumber-js": "^1.13.10",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "catalog:",
		"zod-openapi": "^6.0.0",
		"@cataqui/response": "workspace:*",
		"@cataqui/workerhole": "workspace:*",
		"@cataqui/api-workerhole": "workspace:*",
		"@cataqui/auth-schemas": "workspace:*"
	},
	"devDependencies": {
		"@neondatabase/serverless": "1.2.0",
