{
	"name": "@cataqui/api",
	"version": "1.0.0",
	"description": "Cataquí private user API",
	"author": "Cataquí Team",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"files": [
		"dist",
		"generated",
		"package.json"
	],
	"scripts": {
		"build": "pnpm build:nest",
		"build:nest": "nest build",
		"clean": "ruby -rfileutils -e 'FileUtils.rm_rf(ARGV)' -- coverage dist generated",
		"prebuild": "pnpm prisma:generate",
		"pretest": "pnpm prisma:generate",
		"pretest:cov": "pnpm prisma:generate",
		"pretypecheck": "pnpm prisma:generate",
		"prisma:generate": "prisma generate",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:studio": "prisma studio",
		"prisma:validate": "prisma validate",
		"start": "nest start",
		"start:debug": "nest start --debug --watch",
		"start:dev": "nest start --watch",
		"start:prod": "node dist/main.js",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/static": "^10.1.3",
