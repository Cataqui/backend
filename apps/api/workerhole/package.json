{
	"name": "@cataqui/api-workerhole",
	"version": "1.0.0",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"scripts": {
		"build": "tsdown src/index.ts --format esm --dts --platform neutral --out-dir dist",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"clean": "ruby -rfileutils -e 'FileUtils.rm_rf(ARGV)' -- coverage dist",
		"build:contracts": "pnpm build"
	},
	"dependencies": {
		"@cataqui/workerhole": "workspace:*"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"tsdown": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
