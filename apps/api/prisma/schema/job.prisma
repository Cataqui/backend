model Job {
  id                 String      @id @default(uuid()) @db.Uuid
  posterUserId       String?     @map("poster_user_id") @db.Uuid
  poster             User?       @relation(fields: [posterUserId], references: [id], onDelete: SetNull)
  contactId          String?     @map("contact_id") @db.Uuid
  contact            Contact? @relation(fields: [contactId], references: [id], onDelete: SetNull)
  title              String      @db.Text
  description        String      @db.Text
  descriptionSummary String      @map("description_summary") @db.Text

  locationPoint       Unsupported("geometry(Point,4326)")? @map("location_point")
  fuzzyLatitude       Decimal                              @map("fuzzy_latitude") @db.Decimal(9, 6)
  fuzzyLongitude      Decimal                              @map("fuzzy_longitude") @db.Decimal(9, 6)
  status              JobStatus                            @default(ACTIVE)
  payment             String?                              @db.Text
  postRequest         JobPostRequest?
  createdAt           DateTime                             @default(now()) @map("created_at")
  updatedAt           DateTime                             @updatedAt @map("updated_at")

  @@index([contactId])
  @@index([posterUserId])
  @@index([posterUserId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([status, createdAt(sort: Desc), id(sort: Desc)])
  @@map("jobs")
}

model JobPostRequest {
  id             String   @id @default(uuid()) @db.Uuid
  posterUserId   String   @map("poster_user_id") @db.Uuid
  poster         User     @relation(fields: [posterUserId], references: [id], onDelete: Cascade)
  idempotencyKey String   @map("idempotency_key") @db.Uuid
  requestHash    String   @map("request_hash") @db.VarChar(64)
  jobId          String   @unique @map("job_id") @db.Uuid
  job            Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([posterUserId, idempotencyKey])
  @@map("job_post_requests")
}
