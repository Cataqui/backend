model Account {
  id                  String           @id @db.Uuid
  onboardingCompleted Boolean          @default(false) @map("onboarding_completed")
  admission           AccountAdmission @default(NOT_REQUESTED)
  fromInviteId        String?          @map("from_invite_id") @db.Uuid
  fromInvite          Invite?          @relation("FromInvite", fields: [fromInviteId], references: [id], onDelete: Restrict)

  @@index([fromInviteId])
  @@map("accounts")
}
