model Contact {
  id             String        @id @default(uuid()) @db.Uuid
  ownerProfileId String?       @map("owner_profile_id") @db.Uuid
  contactMethod  ContactMethod @map("contact_method")
  identifier     String        @db.VarChar(320)
  createdAt      DateTime      @default(now()) @map("created_at")
  ownerProfile   Profile?      @relation(fields: [ownerProfileId], references: [id], onDelete: Cascade)
  jobs           Job[]

  @@unique([ownerProfileId, contactMethod, identifier])
  @@index([ownerProfileId])
  @@map("contacts")
}
