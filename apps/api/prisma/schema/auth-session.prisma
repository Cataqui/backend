model AuthSession {
  id                             String    @id @default(uuid()) @db.Uuid
  userId                         String    @map("user_id") @db.Uuid
  authIdentityId                 String?   @map("auth_identity_id") @db.Uuid
  refreshTokenHash               String    @unique @map("refresh_token_hash") @db.Char(64)
  previousRefreshTokenHash       String?   @map("previous_refresh_token_hash") @db.Char(64)
  previousRefreshTokenValidUntil DateTime? @map("previous_refresh_token_valid_until")
  refreshExpiresAt               DateTime  @map("refresh_expires_at")
  lastUsedAt                     DateTime  @map("last_used_at")
  createdAt                      DateTime  @default(now()) @map("created_at")
  updatedAt                      DateTime  @updatedAt @map("updated_at")
  user                           User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  authIdentity                   AuthIdentity? @relation(fields: [authIdentityId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("auth_sessions")
}
