{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"account_id": "1fca946385505503c59dd6a2a4eeb442",
	"name": "cataqui-geovisual-development",
	"main": "./src/app.ts",
	"tsconfig": "./tsconfig.json",
	"compatibility_date": "2026-09-30",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,
	"vars": {
		"ENVIRONMENT": "development"
	},
	"secrets": {
		"required": ["GEOAPIFY_API_KEY"]
	},
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": false
		}
	},
	"preview_urls": false,
	"env": {
		"staging": {
			"name": "cataqui-geovisual-staging",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [
				{
					"pattern": "staging.geovisual.cataqui.com",
					"custom_domain": true
				}
			],
			"vars": {
				"ENVIRONMENT": "staging"
			},
			"secrets": {
				"required": ["GEOAPIFY_API_KEY"]
			},
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"invocation_logs": false
				}
			}
		},
		"production": {
			"name": "cataqui-geovisual-production",
			"workers_dev": false,
			"preview_urls": false,
			"routes": [
				{
					"pattern": "geovisual.cataqui.com",
					"custom_domain": true
				}
			],
			"vars": {
				"ENVIRONMENT": "production"
			},
			"secrets": {
				"required": ["GEOAPIFY_API_KEY"]
			},
			"observability": {
				"enabled": true,
				"logs": {
					"enabled": true,
					"head_sampling_rate": 1,
					"invocation_logs": false
				}
			}
		}
	}
}
