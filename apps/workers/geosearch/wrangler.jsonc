{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"account_id": "1fca946385505503c59dd6a2a4eeb442",
	"name": "cataqui-geosearch-development",
	"main": "./src/app.ts",
	"tsconfig": "./tsconfig.json",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"workers_dev": true,
	"version_metadata": { "binding": "WORKER_VERSION_METADATA" },
	"vars": {
		"ENVIRONMENT": "development",
		"MICROSERVICES_AUTH_JWKS_URL": "http://localhost:3000/v1/auth/microservices/jwks"
	},
	"ratelimits": [
		{
			"name": "ADDRESS_SEARCH_RATE_LIMITER",
			"namespace_id": "20001",
			"simple": { "limit": 30, "period": 60 }
		},
		{
			"name": "ADDRESS_DETAILS_RATE_LIMITER",
			"namespace_id": "20002",
			"simple": { "limit": 10, "period": 60 }
		}
	],
	"secrets": {
		"required": ["GOOGLE_PLACES_API_KEY"]
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false, "persist": true },
		"traces": { "enabled": false }
	},
	"env": {
		"staging": {
			"name": "cataqui-geosearch-staging",
			"workers_dev": false,
			"version_metadata": { "binding": "WORKER_VERSION_METADATA" },
			"routes": [
				{
					"pattern": "staging.geosearch.cataqui.com",
					"custom_domain": true
				}
			],
			"vars": {
				"ENVIRONMENT": "staging",
				"MICROSERVICES_AUTH_JWKS_URL": "https://staging.api.cataqui.com/v1/auth/microservices/jwks"
			},
			"ratelimits": [
				{
					"name": "ADDRESS_SEARCH_RATE_LIMITER",
					"namespace_id": "20001",
					"simple": { "limit": 30, "period": 60 }
				},
				{
					"name": "ADDRESS_DETAILS_RATE_LIMITER",
					"namespace_id": "20002",
					"simple": { "limit": 10, "period": 60 }
				}
			],
			"secrets": {
				"required": ["GOOGLE_PLACES_API_KEY"]
			},
			"observability": {
				"enabled": true,
				"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false, "persist": true },
				"traces": { "enabled": false }
			}
		},
		"production": {
			"name": "cataqui-geosearch-production",
			"workers_dev": false,
			"version_metadata": { "binding": "WORKER_VERSION_METADATA" },
			"routes": [
				{
					"pattern": "geosearch.cataqui.com",
					"custom_domain": true
				}
			],
			"vars": {
				"ENVIRONMENT": "production",
				"MICROSERVICES_AUTH_JWKS_URL": "https://api.cataqui.com/v1/auth/microservices/jwks"
			},
			"ratelimits": [
				{
					"name": "ADDRESS_SEARCH_RATE_LIMITER",
					"namespace_id": "20001",
					"simple": { "limit": 30, "period": 60 }
				},
				{
					"name": "ADDRESS_DETAILS_RATE_LIMITER",
					"namespace_id": "20002",
					"simple": { "limit": 10, "period": 60 }
				}
			],
			"secrets": {
				"required": ["GOOGLE_PLACES_API_KEY"]
			},
			"observability": {
				"enabled": true,
				"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false, "persist": true },
				"traces": { "enabled": false }
			}
		}
	}
}
