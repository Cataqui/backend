{
	"name": "@cataqui/maps-worker",
	"version": "1.0.0",
	"description": "Cataquí places and static maps Worker",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"scripts": {
		"build": "wrangler deploy --dry-run --config wrangler.jsonc --outdir dist",
		"build:staging": "wrangler deploy --dry-run --config wrangler.jsonc --env staging --outdir dist/staging",
		"build:production": "wrangler deploy --dry-run --config wrangler.jsonc --env production --outdir dist/production",
		"cf:deploy:staging": "wrangler deploy --config wrangler.jsonc --env staging",
		"cf:deploy:production": "wrangler deploy --config wrangler.jsonc --env production",
		"cf:dev": "wrangler dev --config wrangler.jsonc --env-file \"$PWD/../../../.env\" --local",
		"cf:types": "wrangler types maps-worker-env.d.ts --config wrangler.jsonc --env-interface MapsWorkerEnv --include-runtime false --env-file \"$PWD/../../../.env.example\"",
		"cf:types:check": "wrangler types maps-worker-env.d.ts --check --config wrangler.jsonc --env-interface MapsWorkerEnv --include-runtime false --env-file \"$PWD/../../../.env.example\"",
		"clean": "node -e \"for (const target of ['coverage','dist']) require('node:fs').rmSync(target,{recursive:true,force:true})\"",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && pnpm cf:types:check"
	},
	"dependencies": {
		"@cataqui/maps-contracts": "workspace:*",
		"@cataqui/microservices-auth-schemas": "workspace:*",
		"@hono/standard-validator": "^0.4.0",
		"@mateo/icons": "github:Ventairy/mateo#main&path:/packages/typescript/mateo-icons",
		"@mateo/palette": "github:Ventairy/mateo#main&path:/packages/typescript/mateo-palette",
		"@resvg/resvg-wasm": "2.6.2",
		"hono": "catalog:",
		"jose": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "1.3.4",
		"@cloudflare/workers-types": "catalog:",
		"@vitest/coverage-istanbul": "4.1.10",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
