{
	"name": "@cataqui/maps-worker",
	"version": "1.0.0",
	"description": "Cataquí places and static maps Worker",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"scripts": {
		"build": "cf build --mode development",
		"build:staging": "cf build --mode staging",
		"build:production": "cf build --mode production",
		"cf:deploy:staging": "cf deploy --mode staging --provision=false",
		"cf:deploy:production": "cf deploy --mode production --provision=false",
		"cf:dev": "node --env-file=.env node_modules/cf/bin/cf dev --mode development",
		"cf:types": "cf workers types --include-runtime=false",
		"clean": "ruby -rfileutils -e 'FileUtils.rm_rf(ARGV)' -- coverage dist generated .cloudflare .worker-build",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "pnpm cf:types && tsc --noEmit",
		"compile": "tsc -p tsconfig.build.json",
		"test:runtime": "bundle exec ruby test/check-worker-runtime.rb"
	},
	"dependencies": {
		"@cataqui/async": "workspace:*",
		"@cataqui/response": "workspace:*",
		"@cataqui/places": "workspace:*",
		"@hono/standard-validator": "^0.4.0",
		"@hono/tsyringe": "catalog:",
		"hono": "catalog:",
		"hono-openapi": "catalog:",
		"reflect-metadata": "catalog:",
		"tsyringe": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/config": "catalog:",
		"@cloudflare/workers-types": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-istanbul": "4.1.11",
		"cf": "catalog:",
		"testdouble": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"imports": {
		"#maps/*": {
			"types": "./src/*.ts",
			"default": "./.worker-build/src/*.js"
		}
	}
}
