# Local-only Auth resources; never reuse API database or Redis credentials.
DATABASE_OWNER_DIRECT_URL=postgresql://auth_owner:local@localhost:5432/auth
UPSTASH_REDIS_REST_URL=https://auth-local.upstash.io
UPSTASH_REDIS_REST_TOKEN=local-auth-redis-token
AUTH_REFRESH_TOKEN_HMAC_KEY_V1_BASE64URL=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA
META_APP_SECRET=local-meta-app-secret
WHATSAPP_AUTH_WEBHOOK_VERIFY_TOKEN=local-webhook-verification-token
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_DB=postgresql://auth:local@localhost:5432/auth
