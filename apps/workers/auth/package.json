{
	"name": "@cataqui/auth-worker",
	"version": "1.0.0",
	"private": true,
	"type": "module",
	"license": "BUSL-1.1",
	"description": "Cataquí account authentication Worker",
	"scripts": {
		"build": "cf build --mode development",
		"cf:deploy:production": "cf deploy --mode production --provision=false",
		"cf:deploy:staging": "cf deploy --mode staging --provision=false",
		"cf:dev": "node --env-file=.env node_modules/cf/bin/cf dev --mode development",
		"cf:types": "cf workers types --include-runtime=false",
		"prisma:generate": "prisma generate",
		"prisma:validate": "prisma validate",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:migrate:dev": "prisma migrate dev",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"typecheck": "pnpm cf:types && tsc --noEmit",
		"clean": "ruby -rfileutils -e 'FileUtils.rm_rf(ARGV)' -- coverage dist src/generated .cloudflare .worker-build",
		"precompile": "pnpm prisma:generate",
		"compile": "tsc -p tsconfig.build.json && ruby -rfileutils -e 'Dir.glob(\"src/generated/**/*.wasm\").each { |source| target = File.join(\".worker-build\", source); FileUtils.mkdir_p(File.dirname(target)); FileUtils.cp(source, target) }'",
		"test:runtime": "bundle exec ruby test/check-worker-runtime.rb",
		"pretest": "pnpm prisma:generate",
		"pretest:cov": "pnpm prisma:generate",
		"pretypecheck": "pnpm prisma:generate"
	},
	"dependencies": {
		"@cataqui/auth-schemas": "workspace:*",
		"@cataqui/response": "workspace:*",
		"@hono/tsyringe": "catalog:",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "catalog:",
		"@upstash/redis": "catalog:",
		"hono": "catalog:",
		"hono-openapi": "catalog:",
		"pg": "^8.16.3",
		"reflect-metadata": "catalog:",
		"tsyringe": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@cloudflare/config": "catalog:",
		"@cloudflare/workers-types": "catalog:",
		"@types/node": "catalog:",
		"@types/pg": "^8.15.6",
		"@vitest/coverage-v8": "catalog:",
		"cf": "catalog:",
		"dotenv": "catalog:",
		"fast-check": "catalog:",
		"prisma": "catalog:",
		"testdouble": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	},
	"imports": {
		"#auth/*": {
			"types": "./src/*.ts",
			"default": "./.worker-build/src/*.js"
		}
	}
}
