model Session {
  id                             String    @id @default(uuid()) @db.Uuid
  accountId                      String    @map("account_id") @db.Uuid
  identityId                     String    @map("identity_id") @db.Uuid
  refreshTokenHash               String    @unique @map("refresh_token_hash") @db.Char(64)
  previousRefreshTokenHash       String?   @map("previous_refresh_token_hash") @db.Char(64)
  previousRefreshTokenValidUntil DateTime? @map("previous_refresh_token_valid_until")
  refreshExpiresAt               DateTime  @map("refresh_expires_at")
  lastUsedAt                     DateTime  @map("last_used_at")
  createdAt                      DateTime  @default(now()) @map("created_at")
  account                        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  identity                       Identity  @relation(fields: [identityId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@index([refreshExpiresAt])
  @@map("sessions")
}
