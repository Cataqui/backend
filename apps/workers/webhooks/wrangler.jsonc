{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"account_id": "1fca946385505503c59dd6a2a4eeb442",
	"name": "cataqui-webhooks-development",
	"main": "./src/app.ts",
	"tsconfig": "./tsconfig.json",
	"compatibility_date": "2026-08-27",
	"compatibility_flags": ["nodejs_compat"],
	"upload_source_maps": true,
	"workers_dev": true,
	"version_metadata": { "binding": "WORKER_VERSION_METADATA" },
	"services": [
		{
			"binding": "API_WORKER",
			"service": "cataqui-api-development",
			"entrypoint": "ApiContainerInboundEntrypoint"
		}
	],
	"vars": {
		"NODE_ENV": "development",
		"WHATSAPP_NOTP_PHONE_NUMBER_ID": "1211194405413752"
	},
	"secrets": {
		"required": ["META_APP_SECRET", "WHATSAPP_AUTH_WEBHOOK_VERIFY_TOKEN"]
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false, "persist": true },
		"traces": { "enabled": false }
	},
	"env": {
		"staging": {
			"name": "cataqui-webhooks-staging",
			"workers_dev": false,
			"version_metadata": { "binding": "WORKER_VERSION_METADATA" },
			"services": [
				{
					"binding": "API_WORKER",
					"service": "cataqui-api-staging",
					"entrypoint": "ApiContainerInboundEntrypoint"
				}
			],
			"routes": [
				{
					"pattern": "staging.webhooks.cataqui.com",
					"custom_domain": true
				}
			],
			"vars": {
				"NODE_ENV": "staging",
				"WHATSAPP_NOTP_PHONE_NUMBER_ID": "1211194405413752"
			},
			"secrets": {
				"required": ["META_APP_SECRET", "WHATSAPP_AUTH_WEBHOOK_VERIFY_TOKEN"]
			},
			"observability": {
				"enabled": true,
				"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false, "persist": true },
				"traces": { "enabled": false }
			}
		},
		"production": {
			"name": "cataqui-webhooks-production",
			"workers_dev": false,
			"version_metadata": { "binding": "WORKER_VERSION_METADATA" },
			"services": [
				{
					"binding": "API_WORKER",
					"service": "cataqui-api-production",
					"entrypoint": "ApiContainerInboundEntrypoint"
				}
			],
			"routes": [
				{
					"pattern": "webhooks.cataqui.com",
					"custom_domain": true
				}
			],
			"vars": {
				"NODE_ENV": "production",
				"WHATSAPP_NOTP_PHONE_NUMBER_ID": "1203689159488121"
			},
			"secrets": {
				"required": ["META_APP_SECRET", "WHATSAPP_AUTH_WEBHOOK_VERIFY_TOKEN"]
			},
			"observability": {
				"enabled": true,
				"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false, "persist": true },
				"traces": { "enabled": false }
			}
		}
	}
}
