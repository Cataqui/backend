{
	"name": "@cataqui/mapshot",
	"version": "1.0.0",
	"description": "Generate location snapshot images from a rendered map",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"scripts": {
		"build": "pnpm tools:build",
		"clean": "ruby -rfileutils -e 'FileUtils.rm_rf(%w[coverage dist generated])'",
		"test": "pnpm test:ruby && ruby build/container/build-container.rb --task test",
		"test:ruby": "pnpm tools:build && bundle exec rake test",
		"test:ruby:cov": "pnpm tools:build && bundle exec rake coverage",
		"test:cov": "ruby build/container/build-container.rb --task coverage && pnpm test:ruby:cov",
		"test:watch": "ruby build/container/build-container.rb --task watch",
		"typecheck": "ruby build/container/build-container.rb --task typecheck",
		"renderer:build": "ruby build/container/build-container.rb --task renderer",
		"test:native:renderer": "ruby build/container/build-container.rb --task native-test",
		"indexes:fetch": "pnpm tools:build && bundle exec ruby build/indexes/manage-indexes.rb --mode fetch",
		"indexes:verify": "pnpm tools:build && bundle exec ruby build/indexes/manage-indexes.rb --mode verify",
		"indexes:container": "pnpm tools:build && bundle exec ruby build/indexes/manage-indexes.rb --mode container",
		"release:data": "bundle exec ruby scripts/releases/release-data.rb",
		"release:probe": "node scripts/releases/probe-mapshot-sdk.ts",
		"release:build": "bundle exec ruby build/image/build-image.rb",
		"tools:build": "ruby build/container/build-container.rb --task tools"
	},
	"dependencies": {
		"@cataqui/async": "workspace:*",
		"@cataqui/mapshot-workerhole": "workspace:*",
		"@cataqui/places": "workspace:*",
		"@cataqui/workerhole": "workspace:*",
		"@mateo/palette": "catalog:",
		"blake3-wasm": "2.1.5",
		"pmtiles": "catalog:",
		"reflect-metadata": "0.2.2",
		"srvx": "1.0.5",
		"tsyringe": "4.10.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@aws-sdk/client-s3": "3.1150.0",
		"@mapbox/vector-tile": "3.0.0",
		"@napi-rs/canvas": "1.0.11",
		"@rspack/cli": "2.2.9",
		"@rspack/core": "catalog:",
		"@types/node": "catalog:",
		"@vitest/coverage-istanbul": "4.1.11",
		"pbf": "5.1.2",
		"sharp": "0.35.5",
		"testdouble": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:"
	}
}
