# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database (PostgreSQL)
DATABASE_POOLER_URL=postgresql://user:password@localhost:5432/cataqui?schema=public
DATABASE_DIRECT_URL=postgresql://user:password@localhost:5432/cataqui?schema=public

# CORS
CORS_ORIGINS=http://localhost:3000

# Protomaps Auth
PROTOMAP_AUTH_SECRET=your-hmac-secret-here
PROTOMAP_URL=https://tiles.cataqui.com

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id
CLOUDFLARE_AI_GATEWAY_ID=your-gateway-id

# AI
AI_GATEWAY_API_TOKEN=your-api-token
