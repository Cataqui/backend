# Application
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
SLEEP_AFTER=5m

# Database (PostgreSQL)
# Least-privilege application runtime connection
DATABASE_APP_POOLER_URL=postgresql://app:password@localhost:5432/cataqui?schema=public
# Privileged local migration connection; never forward this value to the application runtime
DATABASE_OWNER_DIRECT_URL=postgresql://owner:password@localhost:5432/cataqui?schema=public

# CORS
CORS_ORIGINS=http://localhost:3000

# Cloudflare
CLOUDFLARE_ACCOUNT_ID=your-account-id

# AI
DERIVE_JOB_DATA_AI_GATEWAY_ID=cataqui-derive-job-data-development
AI_GATEWAY_API_TOKEN=your-api-token

# Upstash Redis
UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token

# Auth
# Generate with 32 random bytes encoded as unpadded base64url.
# The V1 suffix must match the current refresh-token HMAC key ID declared in application configuration.
AUTH_REFRESH_TOKEN_HMAC_KEY_V1_BASE64URL=replace-with-43-character-base64url-key
# Generate a distinct P-256 keypair for each environment and store the unencrypted PKCS#8 DER private key as base64.
MICROSERVICES_AUTH_JWT_PRIVATE_KEY_V1_PKCS8_BASE64=replace-with-base64-encoded-pkcs8-private-key
GOOGLE_PLACES_API_KEY=replace-with-google-places-api-key
WHATSAPP_NOTP_RECEIVER=+15556625497

# NOTP webhook Worker only
WHATSAPP_NOTP_PHONE_NUMBER_ID=123456789012345
META_APP_SECRET=replace-with-meta-app-secret-at-least-32-characters
WHATSAPP_AUTH_WEBHOOK_VERIFY_TOKEN=replace-with-random-webhook-verify-token-at-least-32-characters
