resource "infisical_secret_folder" "generated" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "generated"
  folder_path      = "/"
  description      = "Credentials and values generated by infrastructure automation."
  force_delete     = false
}

resource "infisical_secret_folder" "api" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "api"
  folder_path      = "/generated"
  description      = "Generated values scoped to the Cataqui API."
  force_delete     = false

  depends_on = [infisical_secret_folder.generated]
}

resource "infisical_secret_folder" "webhooks" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "webhooks"
  folder_path      = "/generated"
  description      = "Generated values scoped to the Webhooks Worker."
  force_delete     = false

  depends_on = [infisical_secret_folder.generated]
}

resource "infisical_secret_folder" "api_runtime" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "runtime"
  folder_path      = "/generated/api"
  description      = "Generated values consumed by the Cataqui API runtime."
  force_delete     = false

  depends_on = [infisical_secret_folder.api]
}

resource "infisical_secret_folder" "webhooks_runtime" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "runtime"
  folder_path      = "/generated/webhooks"
  description      = "Generated values consumed by the Webhooks Worker runtime."
  force_delete     = false

  depends_on = [infisical_secret_folder.webhooks]
}

resource "infisical_secret_folder" "deployment" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "deployment"
  folder_path      = "/generated/api"
  description      = "Generated privileged values consumed only by API deployment and migration tooling."
  force_delete     = false

  depends_on = [infisical_secret_folder.api]
}

resource "infisical_secret_folder" "webhooks_deployment" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "deployment"
  folder_path      = "/generated/webhooks"
  description      = "Generated privileged values consumed only by Webhooks deployment tooling."
  force_delete     = false

  depends_on = [infisical_secret_folder.webhooks]
}

resource "infisical_secret_folder" "opentofu" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "opentofu"
  folder_path      = "/generated"
  description      = "Generated credentials scoped to OpenTofu execution."
  force_delete     = false

  depends_on = [infisical_secret_folder.generated]
}

resource "infisical_secret_folder" "cloudflare_opentofu_root" {
  for_each = local.cloudflare_opentofu_roots

  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = each.value
  folder_path      = "/generated/opentofu"
  description      = "Generated Cloudflare credentials for the ${each.value} OpenTofu root."
  force_delete     = false

  depends_on = [infisical_secret_folder.opentofu]
}

resource "infisical_secret_folder" "maps" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "maps"
  folder_path      = "/generated"
  description      = "Generated values scoped to the Maps Worker."
  force_delete     = false

  depends_on = [infisical_secret_folder.generated]
}

resource "infisical_secret_folder" "maps_deployment" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "deployment"
  folder_path      = "/generated/maps"
  description      = "Generated privileged values consumed only by Maps deployment tooling."
  force_delete     = false

  depends_on = [infisical_secret_folder.maps]
}

resource "infisical_secret_folder" "maps_runtime" {
  project_id       = local.infisical_project_id
  environment_slug = var.environment
  name             = "runtime"
  folder_path      = "/generated/maps"
  description      = "Runtime credentials consumed by the Maps Worker."
  force_delete     = false

  depends_on = [infisical_secret_folder.maps]
}
