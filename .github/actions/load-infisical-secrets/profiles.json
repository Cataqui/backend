{
	"opentofu-bootstrap": {
		"secret_path": "/opentofu/bootstrap",
		"required_secrets": [
			"R2_STATE_ACCESS_KEY_ID",
			"R2_STATE_SECRET_ACCESS_KEY",
			"CLOUDFLARE_API_TOKEN"
		],
		"environment_aliases": {
			"AWS_ACCESS_KEY_ID": "R2_STATE_ACCESS_KEY_ID",
			"AWS_SECRET_ACCESS_KEY": "R2_STATE_SECRET_ACCESS_KEY"
		},
		"authenticate_infisical_provider": true
	},
	"cloudflare-ai-gateways": {
		"secret_path": "/generated/opentofu/cloudflare-ai-gateways",
		"required_secrets": ["CLOUDFLARE_API_TOKEN"],
		"environment_aliases": {},
		"authenticate_infisical_provider": false
	},
	"cloudflare-queues": {
		"secret_path": "/generated/opentofu/cloudflare-queues",
		"required_secrets": ["CLOUDFLARE_API_TOKEN"],
		"environment_aliases": {},
		"authenticate_infisical_provider": false
	}
}
