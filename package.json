{
	"name": "@cataqui/api",
	"version": "1.0.0",
	"description": "Cataquí - the real-time opportunity layer of the city",
	"author": "Cataquí Team",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"engines": {
		"node": ">=20.19.0",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@11.4.0",
	"scripts": {
		"build": "nest build && tsc-alias -f",
		"format": "biome check --write .",
		"start": "nest start --exec tsx",
		"start:dev": "nest start --watch --exec tsx",
		"start:debug": "nest start --debug --watch --exec tsx",
		"start:prod": "node dist/src/main.js",
		"lint": "biome check --write .",
		"lint:check": "biome ci .",
		"typecheck": "tsc --noEmit && tsc --noEmit -p src/platform/cloudflare/tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"prisma:generate": "prisma generate",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"prisma:validate": "prisma validate",
		"commitlint": "commitlint --edit",
		"prepare": "husky",
		"cf:dev": "wrangler dev",
		"cf:deploy": "wrangler deploy",
		"cf:deploy:staging": "wrangler deploy --env staging",
		"cf:deploy:prod": "wrangler deploy --env production",
		"cf:secret:put": "wrangler secret put",
		"cf:containers:list": "wrangler containers list",
		"cf:tail": "wrangler tail"
	},
	"dependencies": {
		"@fastify/cors": "^11.2.0",
		"@fastify/helmet": "^13.0.2",
		"@fastify/static": "^9.1.3",
		"@nestjs/common": "^11.0.1",
		"@nestjs/config": "^4.0.0",
		"@nestjs/core": "^11.0.1",
		"@nestjs/platform-fastify": "^11.0.1",
		"@nestjs/swagger": "^11.0.0",
		"@nestjs/terminus": "^11.0.0",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-neon": "^7.8.0",
		"@prisma/client": "^7.0.0",
		"@upstash/redis": "^1.38.1",
		"ai": "^6.0.202",
		"ai-gateway-provider": "^3.1.3",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.1",
		"libphonenumber-js": "^1.13.3",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.1",
		"zod": "^3.24.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.0",
		"@cloudflare/containers": "^0.3.4",
		"@cloudflare/workers-types": "^4.20260526.1",
		"@commitlint/cli": "^21.0.1",
		"@commitlint/config-conventional": "^21.0.1",
		"@nestjs/cli": "^11.0.0",
		"@nestjs/schematics": "^11.0.0",
		"@nestjs/testing": "^11.0.1",
		"@types/node": "^24.0.0",
		"@vitest/coverage-v8": "^4.1.7",
		"dotenv": "^17.4.2",
		"fast-check": "^4.8.0",
		"fastify": "^5.8.5",
		"husky": "^9.1.7",
		"prisma": "^7.0.0",
		"source-map-support": "^0.5.21",
		"ts-loader": "^9.5.2",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.17",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.22.3",
		"typescript": "^5.7.3",
		"vitest": "^4.1.7",
		"wrangler": "^4.94.0"
	}
}
