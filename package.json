{
	"name": "@cataqui/api",
	"version": "1.0.0",
	"description": "Cataquí - the real-time opportunity layer of the city",
	"author": "Cataquí Team",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"engines": {
		"node": "24.x",
		"pnpm": ">=10.0.0"
	},
	"packageManager": "pnpm@11.4.0",
	"scripts": {
		"build": "nest build && tsc-alias -f",
		"format": "biome check --write .",
		"start": "nest start --exec tsx",
		"start:dev": "nest start --watch --exec tsx",
		"start:debug": "nest start --debug --watch --exec tsx",
		"start:prod": "node dist/src/main.js",
		"lint": "biome check --write .",
		"lint:check": "biome ci .",
		"typecheck": "tsc --noEmit && pnpm cf:typecheck && pnpm cf:types:check",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:cov": "vitest run --coverage",
		"prisma:generate": "prisma generate",
		"prisma:migrate:dev": "prisma migrate dev",
		"prisma:migrate:deploy": "prisma migrate deploy",
		"prisma:studio": "prisma studio",
		"prisma:validate": "prisma validate",
		"commitlint": "commitlint --edit",
		"prepare": "husky",
		"cf:typecheck": "pnpm cf:typecheck:api && pnpm cf:typecheck:geosearch && pnpm cf:typecheck:webhooks",
		"cf:typecheck:api": "tsc --noEmit -p src/platform/cloudflare/workers/api/tsconfig.json",
		"cf:typecheck:geosearch": "tsc --noEmit -p src/platform/cloudflare/workers/geosearch/tsconfig.json",
		"cf:typecheck:webhooks": "tsc --noEmit -p src/platform/cloudflare/workers/webhooks/tsconfig.json",
		"cf:types": "pnpm cf:types:api && pnpm cf:types:geosearch && pnpm cf:types:webhooks",
		"cf:types:api": "wrangler types api-worker-env.d.ts --cwd src/platform/cloudflare/workers/api --config wrangler.jsonc --env-interface ApiWorkerEnv --include-runtime false --env-file \"$PWD/.env.example\" && node src/platform/cloudflare/workers/api/generate-api-worker-environment.mjs",
		"cf:types:api:check": "wrangler types api-worker-env.d.ts --check --cwd src/platform/cloudflare/workers/api --config wrangler.jsonc --env-interface ApiWorkerEnv --include-runtime false --env-file \"$PWD/.env.example\" && node src/platform/cloudflare/workers/api/generate-api-worker-environment.mjs --check",
		"cf:types:geosearch": "wrangler types geosearch-worker-env.d.ts --cwd src/platform/cloudflare/workers/geosearch --config wrangler.jsonc --env-interface GeosearchWorkerEnv --include-runtime false --env-file \"$PWD/.env.example\"",
		"cf:types:geosearch:check": "wrangler types geosearch-worker-env.d.ts --check --cwd src/platform/cloudflare/workers/geosearch --config wrangler.jsonc --env-interface GeosearchWorkerEnv --include-runtime false --env-file \"$PWD/.env.example\"",
		"cf:types:webhooks": "wrangler types webhooks-worker-env.d.ts --cwd src/platform/cloudflare/workers/webhooks --config wrangler.jsonc --config ../api/wrangler.jsonc --env-interface WebhooksWorkerEnv --include-runtime false --env-file \"$PWD/.env.example\"",
		"cf:types:webhooks:check": "wrangler types webhooks-worker-env.d.ts --check --cwd src/platform/cloudflare/workers/webhooks --config wrangler.jsonc --config ../api/wrangler.jsonc --env-interface WebhooksWorkerEnv --include-runtime false --env-file \"$PWD/.env.example\"",
		"cf:types:check": "pnpm cf:types:api:check && pnpm cf:types:geosearch:check && pnpm cf:types:webhooks:check",
		"cf:dev": "wrangler dev --cwd src/platform/cloudflare/workers/webhooks --config wrangler.jsonc --config ../api/wrangler.jsonc --env-file \"$PWD/.env\"",
		"cf:dev:api": "wrangler dev --cwd src/platform/cloudflare/workers/api --config wrangler.jsonc --env-file \"$PWD/.env\"",
		"cf:dev:webhooks": "wrangler dev --cwd src/platform/cloudflare/workers/webhooks --config wrangler.jsonc --env-file \"$PWD/.env\"",
		"cf:dev:geosearch": "wrangler dev --cwd src/platform/cloudflare/workers/geosearch --config wrangler.jsonc --env-file \"$PWD/.env\"",
		"cf:deploy:api:staging": "wrangler deploy --cwd src/platform/cloudflare/workers/api --config wrangler.jsonc --env staging",
		"cf:deploy:api:production": "wrangler deploy --cwd src/platform/cloudflare/workers/api --config wrangler.jsonc --env production",
		"cf:deploy:webhooks:staging": "wrangler deploy --cwd src/platform/cloudflare/workers/webhooks --config wrangler.jsonc --env staging",
		"cf:deploy:webhooks:production": "wrangler deploy --cwd src/platform/cloudflare/workers/webhooks --config wrangler.jsonc --env production",
		"cf:deploy:geosearch:staging": "wrangler deploy --cwd src/platform/cloudflare/workers/geosearch --config wrangler.jsonc --env staging",
		"cf:deploy:geosearch:production": "wrangler deploy --cwd src/platform/cloudflare/workers/geosearch --config wrangler.jsonc --env production",
		"cf:secret:put:api": "wrangler secret put --cwd src/platform/cloudflare/workers/api --config wrangler.jsonc",
		"cf:secret:put:webhooks": "wrangler secret put --cwd src/platform/cloudflare/workers/webhooks --config wrangler.jsonc",
		"cf:secret:put:geosearch": "wrangler secret put --cwd src/platform/cloudflare/workers/geosearch --config wrangler.jsonc",
		"cf:containers:list": "wrangler containers list",
		"cf:tail:api": "wrangler tail --cwd src/platform/cloudflare/workers/api --config wrangler.jsonc",
		"cf:tail:webhooks": "wrangler tail --cwd src/platform/cloudflare/workers/webhooks --config wrangler.jsonc",
		"cf:tail:geosearch": "wrangler tail --cwd src/platform/cloudflare/workers/geosearch --config wrangler.jsonc"
	},
	"dependencies": {
		"@fastify/cors": "^11.3.0",
		"@fastify/helmet": "^13.1.0",
		"@fastify/static": "^10.1.3",
		"@hono/standard-validator": "^0.4.0",
		"@nestjs/common": "12.0.0-alpha.5",
		"@nestjs/config": "12.0.0-next.0",
		"@nestjs/core": "12.0.0-alpha.5",
		"@nestjs/platform-fastify": "12.0.0-alpha.5",
		"@nestjs/swagger": "12.0.0-alpha.2",
		"@nestjs/terminus": "^11.1.1",
		"@nestjs/throttler": "^6.5.0",
		"@prisma/adapter-neon": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@upstash/redis": "^1.38.2",
		"ai": "^6.0.244",
		"ai-gateway-provider": "^3.2.0",
		"hono": "^4.13.1",
		"jose": "^6.2.9",
		"libphonenumber-js": "^1.13.10",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2",
		"zod": "^4.4.3",
		"zod-openapi": "^6.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@cloudflare/containers": "^0.3.7",
		"@cloudflare/workers-types": "^5.20260822.1",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@nestjs/cli": "12.0.0-alpha.6",
		"@nestjs/schematics": "12.0.0-alpha.9",
		"@nestjs/testing": "12.0.0-alpha.5",
		"@standard-schema/spec": "1.1.0",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "^4.1.10",
		"dotenv": "^17.4.2",
		"fast-check": "^4.9.0",
		"fastify": "5.11.2",
		"husky": "^9.1.7",
		"prisma": "^7.9.1",
		"source-map-support": "^0.5.21",
		"ts-loader": "^9.6.2",
		"ts-node": "^10.9.2",
		"tsc-alias": "^1.8.17",
		"tsconfig-paths": "^4.2.0",
		"tsx": "^4.23.9",
		"typescript": "^6.0.3",
		"vitest": "^4.1.10",
		"wrangler": "^4.119.0"
	}
}
