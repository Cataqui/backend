{
	"name": "@cataqui/backend",
	"version": "1.0.0",
	"description": "Cataquí backend applications, Workers, contracts, and delivery infrastructure",
	"author": "Cataquí Team",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"engines": {
		"node": "24.x",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.4.0",
	"scripts": {
		"affected": "node scripts/affected-workspaces.mjs",
		"build": "pnpm -r --if-present run build",
		"build:api": "pnpm --filter \"@cataqui/api...\" run build",
		"build:geosearch": "pnpm --filter \"@cataqui/geosearch-worker...\" run build",
		"build:packages": "pnpm --filter \"./packages/*\" run build",
		"build:webhooks": "pnpm --filter \"@cataqui/webhooks-worker...\" run build",
		"check": "pnpm lint:check && pnpm typecheck && pnpm test:cov && pnpm build",
		"clean": "pnpm -r --if-present run clean",
		"commitlint": "commitlint --edit",
		"format": "biome check --write .",
		"lint": "biome check --write .",
		"lint:check": "biome ci .",
		"prepare": "husky",
		"skills:install": "npx --yes skills@1.5.23 experimental_install",
		"test": "pnpm build:packages && pnpm test:repo && pnpm -r --if-present run test",
		"test:api": "pnpm build:packages && pnpm --filter @cataqui/api run test",
		"test:cov": "pnpm build:packages && pnpm test:repo && pnpm -r --if-present run test:cov",
		"test:geosearch": "pnpm build:packages && pnpm --filter @cataqui/geosearch-worker run test",
		"test:repo": "vitest run --config vitest.config.ts",
		"test:webhooks": "pnpm build:packages && pnpm --filter @cataqui/webhooks-worker run test",
		"typecheck": "pnpm build:packages && pnpm -r --if-present run typecheck"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "^24.13.3",
		"@vitest/coverage-v8": "catalog:",
		"husky": "^9.1.7",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
