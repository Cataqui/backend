{
	"name": "@cataqui/backend",
	"version": "1.0.0",
	"description": "Cataquí backend applications, Workers, contracts, and delivery infrastructure",
	"author": "Cataquí Team",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"engines": {
		"node": "^24.15.0",
		"pnpm": ">=11.0.0"
	},
	"packageManager": "pnpm@11.28.0",
	"scripts": {
		"build": "pnpm -r --if-present run build",
		"build:api": "pnpm --filter \"@cataqui/api-worker...\" run build",
		"build:maps": "pnpm --filter \"@cataqui/maps-worker...\" run build",
		"build:mapshot": "pnpm --filter \"@cataqui/mapshot-worker...\" run build",
		"build:packages": "pnpm --filter \"./packages/*\" run build",
		"build:auth": "pnpm --filter \"@cataqui/auth-worker...\" run build",
		"check": "pnpm check:opentofu && pnpm lint:check && pnpm typecheck && pnpm test:cov && pnpm build && pnpm test:runtime",
		"check:opentofu": "pnpm opentofu:fmt:check && pnpm opentofu:init && pnpm opentofu:test",
		"clean": "pnpm -r --if-present run clean",
		"commitlint": "commitlint --edit",
		"format": "biome check --write .",
		"infrastructure:bootstrap": "bundle exec ruby infrastructure/bootstrap/bootstrap.rb",
		"lint": "biome check --write . && bundle exec rake lint",
		"lint:check": "biome ci . && bundle exec rake lint",
		"opentofu:fmt:check": "tofu fmt -check -recursive infrastructure",
		"opentofu:init": "ruby infrastructure/opentofu/run-root-command.rb init",
		"opentofu:test": "ruby infrastructure/opentofu/run-root-command.rb test",
		"opentofu:validate": "ruby infrastructure/opentofu/run-root-command.rb validate",
		"prepare": "husky",
		"ruby:coverage": "bundle exec rake coverage",
		"ruby:lint": "bundle exec rake lint",
		"ruby:test": "bundle exec rake test",
		"skills:install": "npx --yes skills@1.5.23 experimental_install",
		"test": "pnpm build:contracts && pnpm test:repo && pnpm -r --if-present run test",
		"test:api": "pnpm build:contracts && pnpm --filter @cataqui/api --filter @cataqui/api-worker run test",
		"test:cov": "pnpm build:contracts && pnpm test:repo:cov && pnpm -r --workspace-concurrency=1 --if-present run test:cov",
		"test:maps": "pnpm build:contracts && pnpm --filter @cataqui/maps-worker run test",
		"test:mapshot": "pnpm build:contracts && pnpm --filter @cataqui/mapshot --filter @cataqui/mapshot-worker run test",
		"test:repo": "vitest run --config vitest.config.ts && bundle exec rake -C infrastructure/bootstrap test",
		"test:repo:cov": "vitest run --config vitest.config.ts --coverage && bundle exec rake -C infrastructure/bootstrap coverage",
		"test:runtime": "pnpm -r --workspace-concurrency=1 --if-present run test:runtime",
		"test:auth": "pnpm build:packages && pnpm --filter @cataqui/auth-worker run test",
		"typecheck": "pnpm build:contracts && pnpm -r --if-present run typecheck",
		"build:contracts": "pnpm build:packages && pnpm --recursive --if-present run build:contracts"
	},
	"devDependencies": {
		"@cloudflare/config": "catalog:",
		"@biomejs/biome": "^2.5.7",
		"@commitlint/cli": "^21.2.1",
		"@commitlint/config-conventional": "^21.2.0",
		"@types/node": "catalog:",
		"@vitest/coverage-v8": "catalog:",
		"cf": "catalog:",
		"husky": "^9.1.7",
		"neon": "4.4.0",
		"typescript": "catalog:",
		"vitest": "catalog:",
		"wrangler": "catalog:",
		"zod": "catalog:"
	}
}
