{
	"$schema": "../../../../../node_modules/wrangler/config-schema.json",
	"name": "cataqui-webhooks-development",
	"main": "./worker.ts",
	"tsconfig": "./tsconfig.json",
	"compatibility_date": "2026-08-08",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"queues": {
		"producers": [
			{
				"binding": "VERIFY_WHATSAPP_AUTH_MESSAGE_QUEUE",
				"queue": "cataqui-api-verify-whatsapp-auth-message-development",
			},
		],
	},
	"vars": {
		"WHATSAPP_AUTH_PHONE_NUMBER_ID": "1211194405413752",
	},
	"secrets": {
		"required": ["META_APP_SECRET", "WHATSAPP_AUTH_WEBHOOK_VERIFY_TOKEN"],
	},
	"observability": {
		"enabled": true,
		"logs": { "enabled": true, "head_sampling_rate": 1 },
	},
	"env": {
		"staging": {
			"name": "cataqui-webhooks-staging",
			"workers_dev": false,
			"queues": {
				"producers": [
					{
						"binding": "VERIFY_WHATSAPP_AUTH_MESSAGE_QUEUE",
						"queue": "cataqui-api-verify-whatsapp-auth-message-staging",
					},
				],
			},
			"routes": [
				{
					"pattern": "staging.webhooks.cataqui.com",
					"custom_domain": true,
				},
			],
			"vars": {
				"WHATSAPP_AUTH_PHONE_NUMBER_ID": "1211194405413752",
			},
			"secrets": {
				"required": ["META_APP_SECRET", "WHATSAPP_AUTH_WEBHOOK_VERIFY_TOKEN"],
			},
			"observability": {
				"enabled": true,
				"logs": { "enabled": true, "head_sampling_rate": 1 },
			},
		},
		"production": {
			"name": "cataqui-webhooks-production",
			"workers_dev": false,
			"queues": {
				"producers": [
					{
						"binding": "VERIFY_WHATSAPP_AUTH_MESSAGE_QUEUE",
						"queue": "cataqui-api-verify-whatsapp-auth-message-production",
					},
				],
			},
			"routes": [
				{
					"pattern": "webhooks.cataqui.com",
					"custom_domain": true,
				},
			],
			"vars": {
				"WHATSAPP_AUTH_PHONE_NUMBER_ID": "1203689159488121",
			},
			"secrets": {
				"required": ["META_APP_SECRET", "WHATSAPP_AUTH_WEBHOOK_VERIFY_TOKEN"],
			},
			"observability": {
				"enabled": true,
				"logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": false },
			},
		},
	},
}
