{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"includes": [
			"*.json",
			"*.jsonc",
			"*.mjs",
			"*.ts",
			"apps/**/*.json",
			"apps/**/*.jsonc",
			"apps/**/*.mjs",
			"apps/**/*.ts",
			"infrastructure/**/*.mjs",
			"infrastructure/**/*.json",
			".github/actions/**/*.mjs",
			".github/actions/**/*.json",
			"packages/**/*.json",
			"packages/**/*.mjs",
			"packages/**/*.ts",
			"test/**/*.ts",
			"!skills-lock.json",
			"!apps/api/src/core/i18n/i18n.generated.ts",
			"!apps/api/api-worker-env.d.ts",
			"!apps/workers/**/*-worker-env.d.ts"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 2,
		"lineWidth": 120,
		"lineEnding": "lf"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "off"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"complexity": {
				"useLiteralKeys": "off"
			},
			"correctness": {
				"noUnusedPrivateClassMembers": "off"
			},
			"style": {
				"useImportType": "off",
				"useExportType": "off",
				"noNonNullAssertion": "off"
			},
			"suspicious": {
				"noExplicitAny": "error"
			}
		}
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		},
		"formatter": {
			"quoteStyle": "double",
			"semicolons": "always",
			"trailingCommas": "all"
		}
	},
	"overrides": [
		{
			"includes": ["apps/**/*.spec.ts", "packages/**/*.spec.ts", "test/**/*.spec.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"style": {
						"useTemplate": "off"
					}
				}
			}
		}
	]
}
