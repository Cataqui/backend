{
	"name": "@cataqui/microservices-auth-schemas",
	"version": "1.0.0",
	"description": "Runtime-neutral, service-scoped authentication schemas for Cataqu\u00ed microservices",
	"private": true,
	"license": "BUSL-1.1",
	"type": "module",
	"files": [
		"dist",
		"package.json"
	],
	"exports": {
		"./geoimage": {
			"types": "./dist/geoimage/index.d.ts",
			"import": "./dist/geoimage/index.js"
		},
		"./geosearch": {
			"types": "./dist/geosearch/index.d.ts",
			"import": "./dist/geosearch/index.js"
		},
		"./jwks": {
			"types": "./dist/jwks/index.d.ts",
			"import": "./dist/jwks/index.js"
		}
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"clean": "node -e \"for (const target of ['coverage','dist']) require('node:fs').rmSync(target,{recursive:true,force:true})\"",
		"test": "vitest run",
		"test:cov": "vitest run --coverage",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"zod": "catalog:"
	},
	"devDependencies": {
		"@vitest/coverage-v8": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	}
}
